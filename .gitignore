# Secrets and credentials — never commit (mirrors the developer's .gcloudignore rules)
.env
.google-oauth-client.json
.google-service-account.json
.gmail-token*.json
*.token.json

# Runtime artifacts
output/
logs/
__pycache__/
*.pyc
.DS_Store

# Local Python virtualenv (Cursor Cloud VM uses /workspace/.venv)
.venv/
